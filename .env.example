# Copie este arquivo para ".env" e troque os valores:
#   cp .env.example .env && nano .env
# O arquivo .env NAO vai para o GitHub (esta no .gitignore).

# Banco de dados (PostgreSQL)
DB_NAME=geladeira
DB_USERNAME=geladeira
DB_PASSWORD=troque-esta-senha

# Chave de assinatura do JWT: no minimo 32 caracteres.
# Gere uma com:  openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MINUTES=120

# Origens liberadas para o app mobile
CORS_ALLOWED_ORIGINS=*

# Porta publica da API na VM
API_PORT=8080
